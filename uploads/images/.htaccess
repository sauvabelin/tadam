# Deny access to .htaccess
<Files .htaccess>
    Require all denied
</Files>

# Only allow specific image types
<FilesMatch "\.(?i)(jpg|jpeg|png|gif|webp)$">
    Require all granted
</FilesMatch>

# Deny everything else (including .php files)
<FilesMatch "\.(?i)(php|phtml|php3|php4|php5|php7|phps|phar)$">
    Require all denied
</FilesMatch>
